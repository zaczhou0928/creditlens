#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd "$(dirname "$0")" && pwd)"
credit_python="${CREDIT_PYTHON:-$project_dir/backend/.venv-local/bin/python}"
if [[ ! -x "$credit_python" && -z "${CREDIT_PYTHON:-}" ]]; then
  credit_python="$project_dir/backend/.venv/bin/python"
fi
if [[ ! -x "$credit_python" ]] || ! command -v npm >/dev/null || ! command -v node >/dev/null; then
  echo "Install Python dependencies and Node.js 22.12+ as described in README.md." >&2
  exit 1
fi
if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit((major === 22 && minor >= 12) || major > 22 ? 0 : 1)'; then
  echo "Node.js 22.12+ is required." >&2
  exit 1
fi
backend_pid=""
frontend_pid=""
cleanup() {
  [[ -z "$backend_pid" ]] || kill "$backend_pid" 2>/dev/null || true
  [[ -z "$frontend_pid" ]] || kill "$frontend_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
(cd "$project_dir/backend" && exec "$credit_python" run.py) &
backend_pid=$!
(cd "$project_dir/frontend" && exec npm run dev -- --host 127.0.0.1) &
frontend_pid=$!
echo "CreditLens: http://127.0.0.1:5173 (Ctrl+C to stop)"
wait "$backend_pid" "$frontend_pid"
