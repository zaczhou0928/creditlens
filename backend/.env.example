# Local rule-based demo; external requests are disabled by default.
CREDIT_DEMO_MODE=true
CREDIT_EXTERNAL_MODEL_ENABLED=false
# Fixed reference date for relative-time queries against the synthetic dataset.
CREDIT_REFERENCE_DATE=2026-10-01
CREDIT_ARCHIVE_PATH=data/credit_sessions.db

# Optional model mode: configure your provider and explicitly enable requests.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
SCHEMA_RECALL_THRESHOLD=0.55
BM25_TOP_K=30
DENSE_TOP_K=30
RRF_TOP_K=40
MAX_SCHEMA_FIELDS=20
